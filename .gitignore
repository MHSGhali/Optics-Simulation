# ---- opticsim ----
# Per-VARIANT object trees and the .d dependency files beside them.
build/
# ANCHORED, and that slash is load-bearing: a bare `opticsim` also matches the
# DIRECTORY include/opticsim, which silently excluded every public header from
# the first commit. `git add -A` says nothing about an ignored path, so the
# tree looked complete and only CI on a fresh clone disagreed.
/opticsim
/opticsim-view

# Rendered output. Images under docs/ ARE tracked: they are generated by
# `make docs-images` from the app's own draw path, and the README points at
# them, so they have to survive a clone.
out/

# macOS Finder drops these into any directory anyone opens.
.DS_Store
